# --- Docker (docker compose up -d --wait) -------------------------------------
# Nothing here is required: copy this file to .env only to change something.
# docs/SELF-HOSTING.md describes every service, volume and setting.

# Optional. Empty: the db service generates a password on first start and
# keeps it in the troupe-secrets volume. Set it only for a database created
# with your own (hex characters, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=""
# Another PostgreSQL server instead of the db service.
# DATABASE_URL=""

# Where the studio and the browser edition listen. Keep 127.0.0.1 behind a
# reverse proxy; use 0.0.0.0 to reach them from your LAN.
TROUPE_BIND="127.0.0.1"
TROUPE_PORT="3100"
# The browser edition (web service), and the path it is served under; the
# path is written into its files, so rebuild after changing it
# (docker compose up -d --build web).
# TROUPE_WEB_PORT="3101"
# TROUPE_WEB_BASE="/troupe/"

# The image tag every service runs, e.g. 0.1.0.
# TROUPE_VERSION="latest"

# Memory limits, per service.
# TROUPE_APP_MEMORY="2g"
# TROUPE_DB_MEMORY="1g"
# TROUPE_RENDERER_MEMORY="2g"
# TROUPE_OLLAMA_MEMORY="8g"
# TROUPE_WEB_MEMORY="128m"

# --- First-start wiring (docs/SELF-HOSTING.md#first-start-wiring) -------------
# On by default in Docker: the app adds the stack's renderer as a video model,
# once, and makes it the default if none was chosen. 0 turns it off.
# TROUPE_AUTOCONFIGURE="1"
# TROUPE_RENDERER_URL="http://renderer:8078"
# TROUPE_RENDERER_LABEL="Local renderer"
# Clip lengths it offers, in seconds (1 to 60).
# TROUPE_RENDERER_DURATIONS="4,6,8,10,15"

# --- Access and secrets ----------------------------------------------------
# Optional, at least 12 characters. Without it, the server generates a code on
# first start, prints it in its logs and saves it in the data volume.
# Required on Vercel.
TROUPE_ACCESS_CODE=""

# Optional. Encrypts saved API keys. Without it, a key is generated in the
# data volume (secret.key): back it up with your database. Required on Vercel.
# Generate one with: openssl rand -hex 32
TROUPE_SECRET=""

# --- Video providers ---------------------------------------------------------
# Optional: you can also paste keys in Settings (saved keys take precedence).
GOOGLE_GENAI_API_KEY=""
FAL_KEY=""

# --- Script chat (Settings > Script chat overrides these) --------------------
# Ollama by default; Claude instead once an Anthropic key is set (here or in
# Settings > Provider accounts). auto, ollama or anthropic.
# TROUPE_CHAT_PROVIDER="auto"
# Ollama's address. Docker Compose points the app at the stack's ollama
# service (http://ollama:11434); under pnpm dev it is this default. For the
# Ollama on the computer running Docker: http://host.docker.internal:11434
# (and start the stack with --scale ollama=0).
# OLLAMA_URL="http://127.0.0.1:11434"
# Any model that follows a JSON schema. In Docker the ollama service
# downloads it on first start; otherwise pull it first: ollama pull qwen3:4b
# OLLAMA_MODEL="qwen3:4b"
# Docker only: every model the ollama service downloads and waits for,
# separated by commas (default: OLLAMA_MODEL), and how long it keeps one
# loaded after an answer.
# TROUPE_OLLAMA_MODELS="qwen3:4b"
# OLLAMA_KEEP_ALIVE="30m"
# The Ollama version (CPU image and docker-compose.gpu.yml alike) is pinned
# once, by tag and digest, in ollama/Dockerfile.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
# Added to every request: tone, words to avoid, how to sign off.
# TROUPE_CHAT_INSTRUCTIONS=""
# The word budget: clip seconds x this rate (1 to 5).
# TROUPE_CHAT_WORDS_PER_SECOND="2.5"
# How long one answer may take, in seconds (10 to 1800).
# TROUPE_CHAT_TIMEOUT_S="180"
# Sampling temperature, 0 to 2. Unset: 0.4 for Ollama, the model's own for
# Claude. Claude takes 0 to 1 (higher is sent as 1), and the newer Claude
# models refuse any temperature, so it is sent only to those that accept one
# (docs/SCRIPT-CHAT.md lists them).
# TROUPE_CHAT_TEMPERATURE=""
# Earlier turns sent with each request (0 to 20).
# TROUPE_CHAT_HISTORY_TURNS="6"

# --- Running without Docker (pnpm dev / pnpm start) --------------------------
# DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/troupe"
# TROUPE_DATA_DIR="./data"
# Poll running jobs from the app process (Docker turns this on).
# TROUPE_INPROCESS_WORKER="1"

# --- Actors' pictures (docs/ACTORS.md) ----------------------------------------
# Where browsers load the cast: a path or URL laid out like public/actors
# (<actor>/v1/front.webp, ...). Default: /actors, the pictures checked in.
# TROUPE_ACTOR_PORTRAITS_URL="/actors"

# --- Vercel + Supabase (docs/VERCEL-SUPABASE.md) -----------------------------
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="troupe-media"
# A random secret for the scheduler that calls /api/jobs/reconcile.
# RECONCILE_SECRET=""

# --- Local renderer (the renderer service, docs/LOCAL-MODELS.md) --------------
# A token the renderer requires; the app's first-start wiring saves it with
# the model.
# TROUPE_RENDERER_TOKEN=""
# The renderer's port on 127.0.0.1, published only with docker-compose.dev.yml
# (for a studio run with pnpm dev).
# TROUPE_RENDERER_PORT="8078"
# Kokoro weights: q8 (90 MB), fp16, q4f16, q4 or fp32 (330 MB).
# TROUPE_RENDERER_KOKORO_DTYPE="q8"
# The voices actors are cast from (both pools required).
# TROUPE_RENDERER_KOKORO_VOICES="female=af_heart,af_bella;male=am_michael"
# The actors' pictures drawn in the card: a host folder laid out like
# public/actors, mounted read-only into the container (a relative path is
# read from this folder, the repository root). Running natively
# (pnpm renderer), export PORTRAITS_DIR instead: absolute, or relative to the
# repository root.
# TROUPE_RENDERER_PORTRAITS_DIR="./public/actors"
#
# The renderer's AI video mode (LTX-Video): natively on a Mac
# (`pnpm renderer:ltx:setup` once, then `pnpm renderer:ltx`, and add the model
# http://127.0.0.1:8078/ltx; export these in its shell), or in Docker on an
# NVIDIA GPU (docker compose --profile ltx up -d --build, model
# http://renderer-ltx:8078/ltx; Compose passes these on).
# docs/LOCAL-MODELS.md#settings describes each one.
# LTX_RESOLUTION="480x832"
# LTX_FRAMES="121"
# LTX_FPS="24"
# LTX_SEED=""
# LTX_PROMPT=""
# LTX_NEGATIVE_PROMPT=""
# LTX_UPSCALE="lanczos"
# LTX_LOOP="pingpong"
# LTX_TIMEOUT_S="1800"
# LTX_COMMAND=""
# The default 2B 0.9.8 distilled weights are under the LTXV Open Weights
# License (a paid license above $10M annual revenue). The 0.9.5 checkpoint is
# OpenRAIL-M, with no revenue threshold, and slower (40 guided steps); select
# it with LTX_MODEL="Lightricks/LTX-Video-0.9.5" LTX_TIMESTEPS="" LTX_GUIDANCE="3".
# LTX_MODEL="https://huggingface.co/Lightricks/LTX-Video/blob/main/ltxv-2b-0.9.8-distilled.safetensors"
# LTX_BASE_MODEL="Lightricks/LTX-Video-0.9.5"
# LTX_TEXT_ENCODER=""
# LTX_DEVICE=""
# LTX_TEXT_ENCODER_DEVICE=""
# LTX_DTYPE="bfloat16"
# LTX_TIMESTEPS="1000,993,987,981,975,909,725,0.03"
# LTX_STEPS=""
# LTX_GUIDANCE="1"
# LTX_VAE_TILING="1"
# LTX_VAE_TILE_FRAMES="16"
# LTX_PROMPT_CACHE=""
#
# The browser edition's renderer is configured when the site is built: see
# site/.env.example (the web image reads site/.env when it is built).

# --- The CLI in Docker (docker compose run --rm cli ..., docs/CLI.md) ---------
# Where the files it downloads land (default: this folder).
# TROUPE_CLI_DIR="."
# The project commands use when --project is not given.
# TROUPE_PROJECT=""

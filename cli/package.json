{
  "name": "troupe-cli",
  "version": "0.2.0",
  "private": true,
  "description": "Drive a self-hosted Troupe studio from the terminal: projects, scripts, the script chat, renders, exports and downloads. The built bin is one self-contained file.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "troupe": "dist/troupe.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts"
  },
  "devDependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "esbuild": "^0.28.2",
    "superjson": "^2.2.1"
  }
}

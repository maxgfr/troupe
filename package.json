{
  "name": "troupe",
  "version": "0.1.0",
  "private": true,
  "description": "A personal, self-hosted open-source studio for AI video experiments.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/prepare-media.mjs && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo --hostname 127.0.0.1",
    "lint": "biome lint .",
    "preview": "next build && next start",
    "renderer": "pnpm --filter @troupe/renderer start",
    "site:build": "vite build --config site/vite.config.ts",
    "site:dev": "vite --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "site:test": "playwright test --config site/playwright.config.ts --project chromium",
    "site:test:render": "playwright test --config site/playwright.config.ts --project render",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@supabase/supabase-js": "^2.116.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.25",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@ffprobe-installer/linux-x64": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "kokoro-js": "1.2.1",
    "mediabunny": "^1.61.1",
    "postcss": "^8.5.28",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.28": "^8.5.28",
      "undici@^7.0.0": "^7.29.0",
      "esbuild@<0.25.0": "^0.25.12"
    }
  }
}

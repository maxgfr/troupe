{
  "name": "troupe",
  "version": "0.1.0",
  "private": true,
  "description": "A personal, self-hosted open-source studio for AI video experiments.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/prepare-media.mjs && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo --hostname 127.0.0.1",
    "lint": "biome lint .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@supabase/supabase-js": "^2.117.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.25",
    "postgres": "^3.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@ffprobe-installer/linux-x64": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.28": "^8.5.28",
      "undici@^7.0.0": "^7.29.0",
      "esbuild@<0.25.0": "^0.25.12"
    }
  }
}

# Build context for renderer/Dockerfile (the repository root): only what the
# renderer needs. Replaces the root .dockerignore for this build.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!renderer/package.json
!renderer/src
!renderer/ltx/pyproject.toml
!renderer/ltx/uv.lock
!renderer/ltx/generate.py
!renderer/whisper/pyproject.toml
!renderer/whisper/uv.lock
!renderer/whisper/transcribe.py
!src/modules/scene
!public/actors
**/*.test.ts

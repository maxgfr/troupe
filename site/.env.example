# The browser edition's in-browser renderer, set when the site is built
# (`pnpm site:build`). Copy to site/.env or export the variables; every one is
# optional and the defaults are shown. A bad value stops the build with a
# message naming it. docs/BROWSER-EDITION.md explains each choice.

# --- Voices (Kokoro-82M through kokoro-js) ----------------------------------
# A Kokoro-82M v1.0 ONNX export on the Hugging Face Hub.
# VITE_KOKORO_MODEL="onnx-community/Kokoro-82M-v1.0-ONNX"
# Where the voices run: auto (WebGPU when the browser has it, else the CPU),
# webgpu (refuse browsers without it) or wasm (always the CPU).
# VITE_KOKORO_DEVICE="auto"
# Weights for each device: fp32 (326 MB), fp16 (163 MB), q8 (92 MB),
# q4f16 (155 MB) or q4 (305 MB). Downloaded once per browser.
# VITE_KOKORO_DTYPE_WEBGPU="fp32"
# VITE_KOKORO_DTYPE_WASM="q8"
# The voices actors are cast from; both pools are required. Shared with the
# Node renderer's KOKORO_VOICES, so set both to keep the two alike.
# VITE_KOKORO_VOICES="female=af_heart,af_bella,af_nicole,bf_emma,af_aoede,af_kore,af_sarah;male=am_michael,am_fenrir,am_puck,bm_george,bm_fable"

# --- Video ------------------------------------------------------------------
# Frames per second (the Node renderer draws 24).
# VITE_RENDER_FPS="24"
# H.264 bitrate: very-low, low, medium, high, very-high (scaled to the frame
# size) or bits per second, e.g. 4000000.
# VITE_RENDER_VIDEO_BITRATE="high"
# Seconds between key frames: shorter seeks faster, longer makes smaller files.
# VITE_RENDER_KEYFRAME_S="1"

# --- Audio ------------------------------------------------------------------
# VITE_RENDER_AUDIO_BITRATE="128000"
# Codecs to try, in order; the first the browser can encode wins. Chromium on
# Linux has no AAC encoder, hence the Opus fallback.
# VITE_RENDER_AUDIO_CODECS="aac,opus"

# --- Script chat (WebLLM, on the visitor's GPU) -------------------------------
# A WebLLM prebuilt model id (prebuiltAppConfig in @mlc-ai/web-llm); the build
# stops on one WebLLM does not know. GPUs without shader-f16 get the q4f32
# build of the same model when there is one.
# VITE_WEBLLM_MODEL="Qwen2.5-1.5B-Instruct-q4f16_1-MLC"
# The download size shown before the first request, in MB (0 hides it). Known
# for the default model (880); set it when you change the model.
# VITE_WEBLLM_DOWNLOAD_MB="880"
# Defaults for Settings > Script chat (each visitor can change them there).
# VITE_CHAT_INSTRUCTIONS=""
# VITE_CHAT_WORDS_PER_SECOND="2.5"
# Sampling temperature (0 to 2), the longest answer in tokens (256 to 3072;
# the default model's context is 4096 in all) and the earlier turns sent with
# each request (0 to 20).
# VITE_WEBLLM_TEMPERATURE="0.4"
# VITE_WEBLLM_MAX_TOKENS="1024"
# VITE_CHAT_HISTORY_TURNS="6"

# --- Inspiration library (docs/LIBRARY.md) ----------------------------------------
# Whisper for speech and a sentence-embedding model for search, both run by
# Transformers.js in a worker and downloaded once from the Hugging Face Hub.
# VITE_LIBRARY_WHISPER_MODEL="onnx-community/whisper-base"
# VITE_LIBRARY_WHISPER_DTYPE="q8"
# VITE_LIBRARY_EMBED_MODEL="Xenova/multilingual-e5-small"
# VITE_LIBRARY_EMBED_DTYPE="q8"
# Where they run: wasm (every browser, one CPU thread), webgpu, or auto.
# VITE_LIBRARY_DEVICE="wasm"
# The download size shown before the first analysis, in MB (0 hides it).
# Known for the default models (195); set it when you change them.
# VITE_LIBRARY_DOWNLOAD_MB="195"
# The largest file kept in the browser, and the pictures taken from a video.
# VITE_LIBRARY_MAX_UPLOAD_MB="300"
# VITE_LIBRARY_FRAMES="8"

# --- Actors' pictures -----------------------------------------------------------
# The folder copied to <base>actors/, laid out like public/actors
# (<actor>/v1/front.webp, ...), relative to the repository. docs/ACTORS.md.
# VITE_PORTRAITS_DIR="public/actors"

# --- Where it is served ----------------------------------------------------------
# The URL path the site lives under: /troupe/ on GitHub Pages, / for a domain
# of its own. The Docker image sets it from TROUPE_WEB_BASE.
# VITE_BASE="/troupe/"

# --- Landing page -------------------------------------------------------------
# Where the site is published: its canonical link and social preview
# (og:image) use it. An absolute URL.
# VITE_SITE_URL="https://maxgfr.github.io/troupe/"
# The repository the landing page's docs and source links point at.
# VITE_REPO_URL="https://github.com/maxgfr/troupe"
